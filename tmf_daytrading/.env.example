# 永豐金證券 Shioaji API 金鑰設定檔範本
# 請複製此檔案為 .env 並填入您的實際金鑰：cp .env.example .env

SHIOAJI_API_KEY="YOUR_API_KEY_HERE"
SHIOAJI_SECRET_KEY="YOUR_SECRET_KEY_HERE"

# 實盤下單憑證設定 (僅 --mode live 實盤需要，模擬模式可留空)
SHIOAJI_CA_PATH="/path/to/Sinopac.pfx"
SHIOAJI_CA_PASSWD="YOUR_CA_PASSWORD"
SHIOAJI_PERSON_ID="YOUR_ID_NUMBER"
